# Local Docker verification only; use separate credentials for deployment.
DATABASE_URL=postgres://lite_api:lite-api-local-only@127.0.0.1:15432/lite_api?sslmode=disable
REDIS_URL=redis://127.0.0.1:16379/0
LISTEN_ADDR=127.0.0.1:8080
# Set at least 32 random bytes before running the server.
JWT_SECRET=
# Only used by the explicit bootstrap command; never required by serve.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional comma-separated CIDRs for explicitly authorized private upstreams/proxies.
UPSTREAM_PRIVATE_CIDRS=
# Only used by the explicit upstream-check command; credentials are never committed.
UPSTREAM_BASE_URL=https://buyonce.xyz
UPSTREAM_MODEL=gpt-5.6-luna
UPSTREAM_API_KEY=
