# Local Docker verification only; use separate credentials for deployment.
DATABASE_URL=postgres://lite_api:lite-api-local-only@127.0.0.1:15432/lite_api?sslmode=disable
REDIS_URL=redis://127.0.0.1:16379/0
LISTEN_ADDR=127.0.0.1:8080
# Set at least 32 random bytes before running the server.
JWT_SECRET=
# Only used by the explicit bootstrap command; never required by serve.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional comma-separated CIDRs for explicitly authorized private upstreams/proxies.
UPSTREAM_PRIVATE_CIDRS=
# Optional full reference-price catalog; validated and reloaded every minute.
# Empty uses the bundled, dated compatibility price baseline.
PRICING_FILE=
# Optional Gemini API-key quota display policy JSON; database overrides take precedence.
GEMINI_QUOTA_POLICY=
# Kimi/DeepSeek pay-as-you-go balance probes; threshold uses each returned currency.
GATEWAY_CN_PROVIDERS_BALANCE_CHECK_ENABLED=true
GATEWAY_CN_PROVIDERS_BALANCE_THRESHOLD=0.5
GATEWAY_CN_PROVIDERS_BALANCE_CHECK_INTERVAL_MINUTES=10
# Maximum upstream stream data gap, in seconds; 0 disables gap detection.
# Text: 30-300 seconds. Image streams: 60-1800 seconds.
GATEWAY_STREAM_DATA_INTERVAL_TIMEOUT=180
GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
# Only used by the explicit upstream-check command; credentials are never committed.
UPSTREAM_BASE_URL=https://buyonce.xyz
UPSTREAM_MODEL=gpt-5.6-luna
UPSTREAM_API_KEY=
